{
  "name": "@spend-brake/ee",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE-EE",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start:api": "node --import @spend-brake/shared/telemetry-register dist/main-api.js",
    "start:worker": "node --import @spend-brake/shared/telemetry-register dist/main-worker.js",
    "sign-license": "tsx scripts/sign-license.ts",
    "db:generate": "drizzle-kit generate"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@google-cloud/bigquery": "^9.5.0",
    "@node-saml/node-saml": "^5.2.0",
    "@spend-brake/api": "workspace:^",
    "@spend-brake/budget": "workspace:^",
    "@spend-brake/catalog": "workspace:^",
    "@spend-brake/db": "workspace:^",
    "@spend-brake/shared": "workspace:^",
    "@spend-brake/worker": "workspace:^",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "openid-client": "^6.8.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "jose": "^6.2.12",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.12",
    "xml-crypto": "^6.4.0"
  }
}
