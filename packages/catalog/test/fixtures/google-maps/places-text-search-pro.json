{
  "request": {
    "method": "POST",
    "url": "https://places.googleapis.com/v1/places:searchText",
    "headers": { "X-Goog-FieldMask": "places.id,places.displayName,places.formattedAddress" },
    "body": { "textQuery": "pizza in Sofia", "pageSize": 10 }
  },
  "response": {
    "status": 200,
    "body": {
      "places": [{ "id": "ChIJ1", "displayName": { "text": "Pizza" }, "formattedAddress": "Sofia" }]
    }
  }
}
