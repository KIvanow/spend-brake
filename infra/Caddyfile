# HTTPS in front of the stack (docker-compose.tls.yml). Caddy gets and renews certificates from
# Let's Encrypt for both names; their DNS must point at this host and ports 80 and 443 be open.
{
	email {$ACME_EMAIL}
}

# Where apps and agents send provider calls (the proxy). Every proxy replica is used:
# docker compose ... up -d --scale proxy=3
{$BRAKE_PROXY_DOMAIN} {
	header -Server
	# HTTPS only from the first visit on (the same policy nginx sends for the dashboard).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy {
		dynamic a {
			name proxy
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 2s
		health_uri /healthz
		health_interval 5s
	}
}

# People: the dashboard (which forwards /v1 to the admin API) and alert action links.
{$BRAKE_APP_DOMAIN} {
	encode gzip
	# No software versions in responses (nginx behind sends none either: server_tokens off).
	header -Server
	handle /a/* {
		# nginx sends HSTS for the dashboard; the action pages come from the notifier.
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"
		reverse_proxy notifier:8082
	}
	handle {
		reverse_proxy web:80
	}
}
