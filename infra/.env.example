# Copy to infra/.env and fill in. Generate secrets with:
#   openssl rand -base64 32   (master key, action secret)
#   openssl rand -hex 24      (passwords and the setup token: they go into URLs, keep them hex)

# Encrypts provider keys and webhook URLs (keep it safe: without it they cannot be decrypted).
BRAKE_MASTER_KEY=
# Signs alert action links (API and notifier).
BRAKE_ACTION_SECRET=
# One-time token for `brake init`; remove it after setup.
BRAKE_SETUP_TOKEN=
VALKEY_PASSWORD=
POSTGRES_PASSWORD=

# Where browsers reach the notifier (alert action links) and the dashboard (View links).
BRAKE_PUBLIC_URL=http://localhost:8082
BRAKE_DASHBOARD_URL=http://localhost:3000

# Sign in to the dashboard with emailed links (needs SMTP_URL; on by default in the hosted setup).
BRAKE_EMAIL_SIGN_IN=false

# The proxy's outbound IP addresses, comma-separated (find them with `curl https://api64.ipify.org`
# on the host): the dashboard tells people to restrict their provider keys to them.
BRAKE_PROXY_EGRESS_IPS=

# Optional product analytics in the dashboard (PostHog project key, phc_...). Leave empty and the
# dashboard never loads PostHog or sends anything. A host other than PostHog EU also needs adding
# to connect-src in infra/nginx.conf.
BRAKE_POSTHOG_KEY=
BRAKE_POSTHOG_HOST=https://eu.i.posthog.com

# Where the proxy, API, notifier and dashboard ports listen without the TLS overlay. 0.0.0.0
# publishes them on every interface, over plain HTTP.
BRAKE_BIND_ADDRESS=127.0.0.1

# Valkey's memory ceiling. It never evicts (spend counters must survive), so at the ceiling writes
# fail and the proxy refuses requests: size it for your keys. Keep BRAKE_VALKEY_MEMORY about twice
# this (append-only-file rewrites fork).
VALKEY_MAXMEMORY=256mb
# Per-container limits, defaults fit a 4 GB host; uncomment to change. Also BRAKE_CADDY_* (TLS
# overlay) and BRAKE_BILLING_* (hosted). A _CPUS above the host's CPU count is refused.
# BRAKE_VALKEY_MEMORY=512M
# BRAKE_VALKEY_CPUS=1
# BRAKE_POSTGRES_MEMORY=512M
# BRAKE_POSTGRES_CPUS=1
# BRAKE_API_MEMORY=384M
# BRAKE_API_CPUS=1
# BRAKE_PROXY_MEMORY=512M
# BRAKE_PROXY_CPUS=1
# BRAKE_WORKER_MEMORY=256M
# BRAKE_WORKER_CPUS=0.5
# BRAKE_NOTIFIER_MEMORY=192M
# BRAKE_NOTIFIER_CPUS=0.5
# BRAKE_WEB_MEMORY=64M
# BRAKE_WEB_CPUS=0.5

# TLS overlay only (docker-compose.tls.yml): the two hostnames and the Let's Encrypt contact.
BRAKE_PROXY_DOMAIN=
BRAKE_APP_DOMAIN=
ACME_EMAIL=

# Where the proxy keeps fail-open spend that Valkey could not take by shutdown, replayed on the
# next start (inside the proxystate volume; replicas of a scaled proxy can share it).
# BRAKE_FAIL_OPEN_DIR=/home/node/fail-open

# Let OpenTelemetry collectors on private addresses (a collector on this machine or network).
# Leave off on a server other people use.
ALLOW_PRIVATE_COLLECTORS=false
# Let orgs' custom APIs point at private addresses (an API on this machine or network). Set for the
# API and the proxy. Leave off on a server other people use.
ALLOW_PRIVATE_CUSTOM_APIS=false
# Business / Enterprise single sign-on: let an org's OIDC issuer be on a private address (an IdP
# inside your network). Leave off on a server other people use.
ALLOW_PRIVATE_IDP=false

# Optional: email alerts, catalog drift issues.
SMTP_URL=
# The sender, on a domain your mail provider has verified.
BRAKE_EMAIL_FROM=
OPERATOR_EMAIL=
GITHUB_TOKEN=
GITHUB_REPO=

# Hosted service only (docker-compose.hosted.yml): Stripe in TEST mode (sk_test_ / rk_test_).
STRIPE_SECRET_KEY=
# Real payments: true, with a live key (sk_live_ / rk_live_) above. Billing refuses to start on a
# mismatch: a live key without this, or a test key with it.
BILLING_LIVE_MODE=false
STRIPE_WEBHOOK_SECRET=
BRAKE_HOSTED_SIGNUP=false
# License signing key for Business / Enterprise invoices: a directory holding the PEM file, and
# the file's path inside the container.
BRAKE_LICENSE_SIGNING_KEY_DIR=
BRAKE_LICENSE_SIGNING_KEY_FILE=/run/secrets/license/license-ed25519.pem
